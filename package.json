{
  "name": "keban-extension",
  "version": "0.1.4-alpha.2",
  "private": true,
  "description": "学习通章节播放与可配置 AI 测验助手，实验性 Edge MV3 扩展",
  "license": "MIT",
  "engines": {"node": ">=22"},
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node --test tests/core.test.cjs tests/background.test.cjs",
    "test:browser": "node tests/production-smoke.cjs && node tests/browser.cjs",
    "package": "python scripts/package.py",
    "verify": "npm run check && npm test && npm run test:browser && npm run package"
  },
  "devDependencies": {"playwright": "1.62.1"}
}
