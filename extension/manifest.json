{
  "manifest_version": 3,
  "name": "课伴 · 学习通助手",
  "version": "0.1.3",
  "version_name": "0.1.3-alpha.1",
  "minimum_chrome_version": "114",
  "description": "自动播放和切换学习通章节，使用你配置的 AI 接口填写章节测验。",
  "permissions": ["storage", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "课伴", "default_popup": "popup.html"},
  "options_page": "options.html",
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["https://*.chaoxing.com/mycourse/studentstudy*", "https://*.xuexitong.com/mycourse/studentstudy*", "http://*.chaoxing.com/mycourse/studentstudy*", "http://*.xuexitong.com/mycourse/studentstudy*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
